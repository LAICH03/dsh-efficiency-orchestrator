{
  "name": "dsh-efficiency-orchestrator",
  "version": "0.1.0",
  "description": "One plugin that replaces DSH's read/glob/grep with ops_* aliases and orchestrates batching, loop-breaking, and budget guards to save tokens and steps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LAICH03/dsh-efficiency-orchestrator.git"
  },
  "homepage": "https://github.com/LAICH03/dsh-efficiency-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/LAICH03/dsh-efficiency-orchestrator/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "ops",
    "reasoning-loop",
    "prompt-cache",
    "session-budget"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README_en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.2-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
